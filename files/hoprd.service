[Unit]
Description=Hoprd node
After=network.target

[Service]
User=root
Group=root
Type=oneshot
RemainAfterExit=yes
Restart=on-failure
RestartSec=30s
TimeoutStopSec=90
WorkingDirectory=/opt/hoprd
ExecStart=/usr/bin/docker compose up -d --remove-orphans
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=default.target