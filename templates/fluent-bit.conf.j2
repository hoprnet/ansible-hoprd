[SERVICE]
    Daemon Off
    Flush 1
    Log_Level info
    Parsers_File /fluent-bit/etc/parsers.conf
    HTTP_Server On
    HTTP_Listen 0.0.0.0
    HTTP_Port 2020
    Health_Check On
# [INPUT]
#     Name        tail
#     Path        /var/lib/docker/containers/*/*.log
#     Parser      docker
#     Tag         docker.*
#     DB          /var/log/fluent-bit-k8s-container.db
#     Mem_Buf_Limit 20MB
#     Skip_Long_Lines On

[INPUT]
    Name   forward
    Listen 0.0.0.0
    Port   24224
    Tag    hoprd.*

# Remove stream and time keys
[FILTER]
    Name        record_modifier
    Match       hoprd.*
    Remove_Key  stream
    Remove_Key  time

# Parser filter as JSON object from json_log attribute
[FILTER]
    Name         parser
    Match        hoprd.*
    Key_Name     log
    Parser       json
    Reserve_Data On

# Filter by logs emitted by hoprd containers only
[FILTER]
    Name   grep
    Match  hoprd.*
    Regex  threadId .*

# Extract hoprd custom fields using prefix field_*
[FILTER]
    Name nest
    Match hoprd.*
    Operation lift
    Add_prefix field_
    Nested_under fields

# Exclude empty messages
[FILTER]
    Name         grep
    Match        hoprd.*
    Regex        field_message .+

# Extract span fields using prefix span_*
[FILTER]
    Name nest
    Match hoprd.*
    Operation lift
    Add_prefix span_
    Nested_under span

# Truncate message to 250 characters
[FILTER]
    Name   lua
    Match  hoprd.*
    Script /fluent-bit/scripts/truncate.lua  
    Call   truncate_message

# Flatten spans array
[FILTER]
    Name   lua
    Match  hoprd.*
    Script /fluent-bit/scripts/flatten_spans.lua
    Call   flatten_spans_fields

# Rename fields
[FILTER]
    Name    modify
    Match   hoprd.*
    Add     namespace {{ hoprd_namespace }}
    Add     hoprd_node_name {{ hoprd_node_name }}
    Add     host {{ hoprd_node_name }}
    Add     docker_image_tag {{ hoprd_version }}
    Add     label_instance {{ hoprd_node_name }}
    Add     label_network {{ hoprd_network }}
    Add     label_peerId {{ hoprd_peer_id }}
    Add     label_nativeAddress {{ hoprd_native_address }}
    Rename  level severity
    Remove  spans

# Routing: Split logs into "debug" pipeline or "output" pipeline
# If DEBUG, send to debug pipeline (debug.kube.*) and discard original
# If NOT DEBUG, send directly to output (output.kube.*) and discard original
[FILTER]
    Name          rewrite_tag
    Match         hoprd.*
    Rule          severity ^(DEBUG)$ debug.$TAG false
    Rule          severity ^(?!DEBUG).*$ output.$TAG false
    Emitter_Name  re_emitted_logs

# Pipeline: Rate limit DEBUG logs
# - Rate:     150 logs allowed per Interval.
# - Interval: 15s (15 seconds). The base unit of time.
# - Window:   8 (intervals). The sliding window size.
#
# Result:
# This limits DEBUG logs to an average of 150 logs per 15 seconds calculated over a 8 sliding window (Window * Interval). Equivalent to aprox 10 logs/second.
# Burst capability is determined by the Window size, smoothing out spikes.
[FILTER]
    Name     throttle
    Match    debug.hoprd.*
    Rate     150 # Rate limit to 150 logs per Interval = 10 logs/second
    Window   8  # Window of 2 minutes = 8 intervals of 15s
    Interval 15s
    Print_Status true

[FILTER]
    Name     throttle
    Match    output.*
    Rate     150 # Rate limit to 150 logs per Interval = 10 logs/second
    Window   8 # Window of 2 minutes = 8 intervals of 15s
    Interval 15s
    Print_Status true

# Routing: Send finished DEBUG logs to Output
[FILTER]
    Name          rewrite_tag
    Match         debug.hoprd.*
    Rule          severity .* output.$TAG true

[OUTPUT]
    Name                gelf
    Match               output.*
    Host                {{ hoprd_fluentbit_graylog_host }}
    Port                12201
    Mode                tcp
    Gelf_Timestamp_Key  date
    tls                 On
    tls.verify          On
    tls.debug           4
    tls.ca_file         /fluent-bit/ssl/ca.crt
    tls.crt_file        /fluent-bit/ssl/tls.crt
    tls.key_file        /fluent-bit/ssl/tls.key

